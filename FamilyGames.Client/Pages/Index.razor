@page "/"
<PageTitle>Family Game Tracker</PageTitle>

<div style="text-align:center;padding:4rem 1rem;">
    <div style="font-size:5rem;margin-bottom:1rem;">🎮</div>
    <h1 style="font-size:2.5rem;color:#6c63ff;font-weight:800;">Family Game Tracker</h1>
    <p style="font-size:1.1rem;color:#666;max-width:480px;margin:0 auto 2rem;">
        Håll koll på familjens matcher – tennis, schack, Monopoly och mer!
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        <a href="/players" style="background:#6c63ff;color:white;padding:0.8rem 1.8rem;border-radius:10px;text-decoration:none;font-weight:700;">
            👥 Hantera spelare
        </a>
        <a href="/matches" style="background:white;color:#6c63ff;padding:0.8rem 1.8rem;border-radius:10px;text-decoration:none;font-weight:700;border:2px solid #6c63ff;">
            ⚔️ Visa matcher
        </a>
    </div>
</div>