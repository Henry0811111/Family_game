@page "/matches"
@inject HttpClient Http
@using FamilyGames.Client.Models
@using System.Net.Http.Json

<PageTitle>Matcher</PageTitle>
<h1 style="color:#6c63ff;font-weight:800;">⚔️ Matcher</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div style="background:#ffebee;color:#c62828;padding:0.8rem 1rem;border-radius:8px;margin-bottom:1rem;font-weight:600;">
        ⚠️ @errorMessage
    </div>
}

<div style="background:white;border-radius:16px;padding:1.5rem;box-shadow:0 4px 20px rgba(0,0,0,0.08);margin-bottom:1.5rem;">
    <h5 style="font-weight:700;margin-bottom:1rem;">@(editingId.HasValue ? "✏️ Redigera match" : "➕ Logga match")</h5>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap;">
        <select @bind="formGameType"
                style="padding:0.6rem 1rem;border-radius:8px;border:1px solid #ddd;flex:1;min-width:160px;">
            <option value="">Välj speltyp...</option>
            <option>🎾 Tennis</option>
            <option>♟️ Schack</option>
            <option>🎲 Monopol</option>
            <option>🃏 Kortspel</option>
            <option>🏓 Bordtennis</option>
            <option>🎳 Bowling</option>
        </select>
        @if (!editingId.HasValue)
        {
            <select @bind="formPlayerId"
                    style="padding:0.6rem 1rem;border-radius:8px;border:1px solid #ddd;flex:1;min-width:160px;">
                <option value="0">Välj spelare...</option>
                @if (players != null)
                {
                    @foreach (var p in players)
                    {
                        <option value="@p.Id">@p.AvatarEmoji @p.Name</option>
                    }
                }
            </select>
        }
        <input type="number" placeholder="Poäng" @bind="formScore"
               style="padding:0.6rem 1rem;border-radius:8px;border:1px solid #ddd;width:90px;" />
        <label style="display:flex;align-items:center;gap:6px;font-weight:600;">
            <input type="checkbox" @bind="formIsWinner" /> 🏆 Vinnare?
        </label>
        <button @onclick="SaveMatch"
                style="background:#6c63ff;color:white;padding:0.6rem 1.4rem;border-radius:8px;border:none;font-weight:700;cursor:pointer;">
            Spara
        </button>
        @if (editingId.HasValue)
        {
            <button @onclick="CancelEdit"
                    style="background:#eee;color:#333;padding:0.6rem 1rem;border-radius:8px;border:none;cursor:pointer;">
                Avbryt
            </button>
        }
    </div>
    <input placeholder="Anteckningar (valfritt)" @bind="formNotes"
           style="margin-top:0.8rem;width:100%;padding:0.6rem 1rem;border-radius:8px;border:1px solid #ddd;box-sizing:border-box;" />
</div>

@if (matches is null)
{
    <p>Laddar matcher...</p>
}
else if (!matches.Any())
{
    <p style="color:#999;">Inga matcher loggade än. Lägg till en ovan! 👆</p>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1rem;">
        @foreach (var m in matches.OrderByDescending(x => x.PlayedAt))
        {
            <div style="background:white;border-radius:16px;padding:1.2rem;box-shadow:0 4px 20px rgba(0,0,0,0.08);">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;">
                    <div>
                        <strong>@m.GameType</strong><br/>
                        <small style="color:#999;">
                            👤 @m.PlayerName  |  📅 @m.PlayedAt.ToLocalTime().ToString("d MMM yyyy")
                        </small>
                        @if (m.Score.HasValue)
                        {
                            <br/><small>Poäng: @m.Score</small>
                        }
                        @if (!string.IsNullOrEmpty(m.Notes))
                        {
                            <br/><small style="color:#777;">📝 @m.Notes</small>
                        }
                    </div>
                    <span style="background:@(m.IsWinner ? "#e8f5e9" : "#f5f5f5");color:@(m.IsWinner ? "#2e7d32" : "#999");border-radius:20px;padding:3px 12px;font-size:0.8rem;white-space:nowrap;">
                        @(m.IsWinner ? "🏆 Vinst" : "😔 Förlust")
                    </span>
                </div>
                <div style="display:flex;gap:0.5rem;margin-top:0.8rem;">
                    <button @onclick="() => StartEdit(m)"
                            style="flex:1;padding:0.5rem;border-radius:8px;border:1px solid #6c63ff;color:#6c63ff;background:white;cursor:pointer;">
                        ✏️ Redigera
                    </button>
                    <button @onclick="() => DeleteMatch(m.Id)"
                            style="padding:0.5rem 0.8rem;border-radius:8px;border:none;background:#ef5350;color:white;cursor:pointer;">
                        🗑️
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<MatchModel>?  matches;
    private List<PlayerModel>? players;
    private string  errorMessage  = string.Empty;
    private string  formGameType  = string.Empty;
    private int     formPlayerId  = 0;
    private int?    formScore;
    private bool    formIsWinner;
    private string? formNotes;
    private int?    editingId;

    protected override async Task OnInitializedAsync()
    {
        // Ladda matcher och spelare parallellt
        await Task.WhenAll(LoadMatches(), LoadPlayers());
    }

    private async Task LoadMatches()
    {
        try   { matches = await Http.GetFromJsonAsync<List<MatchModel>>("api/matches"); }
        catch { errorMessage = "Kunde inte ladda matcher. Är API:et igång?"; }
    }

    private async Task LoadPlayers()
    {
        try   { players = await Http.GetFromJsonAsync<List<PlayerModel>>("api/players"); }
        catch { errorMessage = "Kunde inte ladda spelare."; }
    }

    private void StartEdit(MatchModel m)
    {
        editingId    = m.Id;     formGameType = m.GameType;
        formPlayerId = m.PlayerId; formScore  = m.Score;
        formIsWinner = m.IsWinner; formNotes  = m.Notes;
    }

    private void CancelEdit()
    {
        editingId = null; formGameType = string.Empty;
        formPlayerId = 0; formScore = null;
        formIsWinner = false; formNotes = null;
    }

    private async Task SaveMatch()
    {
        if (string.IsNullOrWhiteSpace(formGameType))
            { errorMessage = "Speltyp krävs."; return; }
        if (!editingId.HasValue && formPlayerId == 0)
            { errorMessage = "Välj en spelare."; return; }
        try
        {
            HttpResponseMessage response;
            if (editingId.HasValue)
            {
                var dto = new { GameType = formGameType, Score = formScore,
                                IsWinner = formIsWinner, Notes = formNotes };
                response = await Http.PutAsJsonAsync($"api/matches/{editingId}", dto);
            }
            else
            {
                var dto = new { GameType = formGameType, PlayerId = formPlayerId,
                                Score = formScore, IsWinner = formIsWinner, Notes = formNotes };
                response = await Http.PostAsJsonAsync("api/matches", dto);
            }
            if (!response.IsSuccessStatusCode)
                { errorMessage = await response.Content.ReadAsStringAsync(); return; }

            CancelEdit();
            errorMessage = string.Empty;
            await LoadMatches();
        }
        catch { errorMessage = "Misslyckades att spara. Är API:et igång?"; }
    }

    private async Task DeleteMatch(int id)
    {
        try   { await Http.DeleteAsync($"api/matches/{id}"); await LoadMatches(); }
        catch { errorMessage = "Kunde inte radera matchen."; }
    }
}